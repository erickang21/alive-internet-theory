{
  "name": "alive-internet-theory-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that rates YouTube videos as likely human, possibly AI, or heavy AI use",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "lint": "eslint src build.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{js,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{js,json,html}\"",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.9.0",
    "prettier": "^3.3.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.5.3"
  }
}
