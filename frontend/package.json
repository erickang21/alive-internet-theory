{
  "name": "alive-internet-theory-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that rates YouTube videos as likely human, possibly AI, or AI slop",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,css}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"*.{js,json}\"",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.0"
  }
}
