# Copy to backend/.env and fill in real values. Never commit .env.

# GPTZero (https://api.gptzero.me, key from hackathon form)
GPTZERO_API_KEY=your-gptzero-api-key

# Anthropic API (console.anthropic.com), used to fact-check educational videos.
# For venv runs you can delete this line and use `ant auth login` instead (a
# placeholder key here would override the login); Docker needs the key.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Storage. Defaults are backend/data/alive_internet_theory.db and
# backend/data/media; leave these commented when using Docker Compose, which
# keeps both in a volume at /data.
# SQLITE_PATH=backend/data/alive_internet_theory.db
# MEDIA_DIR=backend/data/media

# Flask
FLASK_DEBUG=0
PORT=5000
