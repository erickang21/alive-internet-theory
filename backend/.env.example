# Copy to backend/.env and fill in real values. Never commit .env.

# GPTZero (https://api.gptzero.me, key from hackathon form)
GPTZERO_API_KEY=your-gptzero-api-key

# YouTube Data API v3 (console.cloud.google.com, public reads only)
YOUTUBE_API_KEY=your-youtube-data-api-key

# SQLite database file. Defaults to backend/data/alive_internet_theory.db; leave
# commented when using Docker Compose, which stores it in a volume at /data.
# SQLITE_PATH=backend/data/alive_internet_theory.db

# Flask
FLASK_DEBUG=0
PORT=5000
