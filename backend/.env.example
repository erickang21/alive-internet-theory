# Copy to backend/.env and fill in real values. Never commit .env.

# GPTZero (https://api.gptzero.me, key from hackathon form)
GPTZERO_API_KEY=your-gptzero-api-key

# YouTube Data API v3 (console.cloud.google.com, public reads only)
YOUTUBE_API_KEY=your-youtube-data-api-key

# MongoDB Atlas (cluster: alive-internet-theory). Take the connection string
# from Database > Connect > Drivers, with the database user's credentials in
# the separate variables below rather than embedded in the URI.
MONGODB_URI=mongodb+srv://alive-internet-theory.example.mongodb.net
MONGODB_USERNAME=your-database-username
MONGODB_PASSWORD=your-database-password
MONGODB_DB_NAME=alive_internet_theory

# Flask
FLASK_DEBUG=0
PORT=5000
