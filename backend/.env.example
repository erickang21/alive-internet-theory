# Copy to backend/.env and fill in real values. Never commit .env.

# GPTZero (https://api.gptzero.me, key from hackathon form)
GPTZERO_API_KEY=your-gptzero-api-key

# Anthropic API (console.anthropic.com), used to fact-check educational videos.
# For venv runs you can delete this line and use `ant auth login` instead (a
# placeholder key here would override the login); Docker needs the key.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Storage. Defaults are backend/data/alive_internet_theory.db and
# backend/data/media; leave these commented when using Docker Compose, which
# keeps both in a volume at /data.
# SQLITE_PATH=backend/data/alive_internet_theory.db
# MEDIA_DIR=backend/data/media

# Flask
FLASK_DEBUG=0
PORT=5000

# --- Fact-check engine (backend/factcheck/) ---
# BROWSERBASE_API_KEY belongs in the REPO-ROOT .env (one level above this
# file), not here: backend/config.py loads the repo-root .env first, then
# this file on top, so a value here would still override it. Listed for
# reference only.
# BROWSERBASE_API_KEY=your-browserbase-api-key

# Which LLM backend backend/factcheck/llm.py uses: openai (default), gateway
# (Browserbase Model Gateway, OpenAI-compatible), or anthropic.
FACTCHECK_LLM_PROVIDER=openai
FACTCHECK_MODEL=gpt-5
OPENAI_API_KEY=your-openai-api-key

# Only used when FACTCHECK_LLM_PROVIDER=gateway. Leave unset: Browserbase
# ships no public REST endpoint for Model Gateway as of 2026-09-19.
# BROWSERBASE_GATEWAY_URL=

FACTCHECK_MAX_CLAIMS=40
FACTCHECK_CONCURRENCY=4
FACTCHECK_SOURCES_PER_CLAIM=3
FACTCHECK_ENABLE_STAGEHAND=0
